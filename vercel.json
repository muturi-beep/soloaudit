{
  "version": 2,
  "functions": {
    "api/contact.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/api/contact",
      "dest": "/api/contact.php",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/api/contact.php",
      "dest": "/api/contact.php",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}